# Вход из интернета: https://PUBLIC_HOST (свой домен -> белый IP роутера -> этот компьютер).
# Caddy сам получает и продлевает сертификат Let's Encrypt (нужны проброшенные порты 80 и 443)
# и передаёт запросы серверу api. Наружу открыт только HTTP API; ntfy и порт платы — нет.
{$PUBLIC_HOST} {
	encode gzip
	reverse_proxy api:8000
}
