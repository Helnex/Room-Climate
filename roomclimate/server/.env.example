REDIS_URL=redis://redis:6379/0
SQLITE_PATH=/data/roomclimate.db
API_HOST=0.0.0.0
API_PORT=8000
CURRENT_TTL_SECONDS=60
# Секрет платы: тот же INGEST_TOKEN указать сборщику на Raspberry Pi.
# scripts/start.ps1 создаёт его сам. Вручную: python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_TOKEN=
SESSION_TTL_DAYS=30
# Секретная тема push-уведомлений ntfy (start.ps1 создаёт сама).
NTFY_TOPIC=
# Тревога только если выход за порог держится дольше N секунд.
ALERT_DELAY_SECONDS=60
STALE_AFTER_SECONDS=180
# Почта для кодов восстановления пароля. Без SMTP_HOST код пишется в журнал сервера:
#   docker logs roomclimate-api-1 | findstr "Код восстановления"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=# Доступ из интернета через Cloudflare Tunnel (start.ps1 -Tunnel или TUNNEL=1).
TUNNEL=
# Постоянный туннель со своим доменом (ключи в server/.cloudflared/, config.yml там же).
# Пусто — временный адрес *.trycloudflare.com, меняется при перезапуске.
CLOUDFLARED_COMMAND=
# Постоянный адрес стенда из интернета — его показывает start.ps1 и страница /connect.
PUBLIC_URL=
