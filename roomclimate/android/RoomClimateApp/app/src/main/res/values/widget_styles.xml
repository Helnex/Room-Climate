<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Плитка виджета и карточки в шторке: полупрозрачная «стеклянная» карточка поверх цвета
         состояния. Подпись и значение — отдельные строки в одну линию: при крупном системном
         шрифте или узком экране текст уменьшается (autoSize), а не переносится по слогам. -->
    <style name="WidgetTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/widget_tile</item>
        <item name="android:paddingStart">9dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">7dp</item>
    </style>

    <style name="WidgetTileLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">#E6FFFFFF</item>
        <item name="android:textSize">11sp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">8sp</item>
        <item name="android:autoSizeMaxTextSize">11sp</item>
    </style>

    <style name="WidgetTileValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">10sp</item>
        <item name="android:autoSizeMaxTextSize">16sp</item>
    </style>
</resources>
