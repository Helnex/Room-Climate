<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Базовая тема приложения (светлая, без верхней панели) -->
    <style name="Base.Theme.RoomClimate" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Окно «от края до края» (Android 15+): фон под строкой состояния и панелью
             навигации — цвета приложения, значки системы — тёмные на светлом фоне. -->
        <item name="android:windowBackground">@color/bg_default</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.RoomClimate" parent="Base.Theme.RoomClimate" />
</resources>
