<?xml version="1.0" encoding="utf-8"?>
<!-- Развёрнутая карточка климата в шторке: крупная температура, состояние, плитки и совет. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/notif_bg_comfort"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/nTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="38sp" />

        <TextView
            android:id="@+id/nLine"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/nTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:maxLines="1"
            android:textColor="#D9FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <LinearLayout
            style="@style/WidgetTile"
            android:layout_marginEnd="4dp">
            <TextView android:id="@+id/nTileHumidityLabel" style="@style/WidgetTileLabel" />
            <TextView android:id="@+id/nTileHumidityValue" style="@style/WidgetTileValue" />
        </LinearLayout>
        <LinearLayout
            style="@style/WidgetTile"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp">
            <TextView android:id="@+id/nTileDewLabel" style="@style/WidgetTileLabel" />
            <TextView android:id="@+id/nTileDewValue" style="@style/WidgetTileValue" />
        </LinearLayout>
        <LinearLayout
            style="@style/WidgetTile"
            android:layout_marginStart="4dp">
            <TextView android:id="@+id/nTileRangeLabel" style="@style/WidgetTileLabel" />
            <TextView android:id="@+id/nTileRangeValue" style="@style/WidgetTileValue" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/nAdvice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#E6FFFFFF"
        android:textSize="13sp" />
</LinearLayout>
