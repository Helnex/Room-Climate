<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNav"
    android:layout_width="match_parent"
    android:layout_height="84dp"
    android:background="@color/surface"
    android:orientation="horizontal"
    android:paddingTop="9dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/navDashboard"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/a11y_nav_dashboard"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_compass"
            android:importantForAccessibility="no"
            app:tint="@color/gray_text" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_dashboard"
            android:textColor="@color/gray_text"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navHistory"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/a11y_nav_history"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:importantForAccessibility="no"
            app:tint="@color/gray_text" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_history"
            android:textColor="@color/gray_text"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navDevices"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/a11y_nav_devices"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_manage"
            android:importantForAccessibility="no"
            app:tint="@color/gray_text" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_devices"
            android:textColor="@color/gray_text"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navSettings"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/a11y_nav_settings"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_preferences"
            android:importantForAccessibility="no"
            app:tint="@color/gray_text" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_settings"
            android:textColor="@color/gray_text"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navAccount"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/a11y_nav_account"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_myplaces"
            android:importantForAccessibility="no"
            app:tint="@color/gray_text" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_account"
            android:textColor="@color/gray_text"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
