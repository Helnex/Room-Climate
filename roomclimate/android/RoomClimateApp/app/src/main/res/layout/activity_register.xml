<?xml version="1.0" encoding="utf-8"?>
<!-- Регистрация: форма по центру экрана (отступ от строки состояния — RoomClimateApp),
     пароль с кнопкой «показать / скрыть» и подсказкой о длине. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_default"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="32dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/header_label"
            android:textColor="@color/gray_text"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/register_title"
            android:textColor="@color/dark_text"
            android:textSize="28sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/register_desc"
            android:textColor="@color/gray_text"
            android:textSize="14sp" />

        <!-- Карточка с полями -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_white_card"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/editName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:autofillHints="givenName"
                android:background="@drawable/bg_input_field"
                android:hint="@string/hint_name"
                android:inputType="textPersonName|textCapWords"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="@color/dark_text"
                android:textColorHint="@color/gray_text_light"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/editSurname"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:autofillHints="familyName"
                android:background="@drawable/bg_input_field"
                android:hint="@string/hint_surname"
                android:inputType="textPersonName|textCapWords"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="@color/dark_text"
                android:textColorHint="@color/gray_text_light"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/editEmailReg"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:autofillHints="emailAddress"
                android:background="@drawable/bg_input_field"
                android:hint="@string/hint_email_reg"
                android:inputType="textEmailAddress"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="@color/dark_text"
                android:textColorHint="@color/gray_text_light"
                android:textSize="14sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp">

                <EditText
                    android:id="@+id/editPasswordReg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:autofillHints="newPassword"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/hint_password"
                    android:inputType="textPassword"
                    android:paddingStart="20dp"
                    android:paddingEnd="52dp"
                    android:textColor="@color/dark_text"
                    android:textColorHint="@color/gray_text_light"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btnTogglePasswordReg"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/password_show"
                    android:padding="12dp"
                    android:src="@drawable/ic_eye" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="6dp"
                android:text="@string/password_rules"
                android:textColor="@color/gray_text"
                android:textSize="12sp" />

            <!-- Код приглашения: нужен только при регистрации вне домашней сети стенда. -->
            <EditText
                android:id="@+id/editInviteReg"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_field"
                android:hint="@string/hint_invite_code"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="64"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="@color/dark_text"
                android:textColorHint="@color/gray_text_light"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="6dp"
                android:text="@string/invite_code_rules"
                android:textColor="@color/gray_text"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnCreateAccount"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_btn_primary"
                android:text="@string/btn_create_account"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <!-- Согласие на обработку персональных данных (152-ФЗ), ссылка на политику -->
            <TextView
                android:id="@+id/tvPrivacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:minHeight="40dp"
                android:text="@string/privacy_notice"
                android:textColor="@color/green_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvGoToLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="@string/already_have_account"
            android:textColor="@color/green_primary"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
