<?xml version="1.0" encoding="utf-8"?>
<!-- Строка «Устройств»: помещение или датчик. Иконка, заголовок, подпись, строка состояния,
     справа «+» (добавить датчик в помещение) или стрелка. Заполняет DevicesActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/regIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/rc_icon_square"
        android:importantForAccessibility="no"
        android:padding="8dp"
        app:tint="@color/green_primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/regTitle"
            style="@style/RC.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/regSub"
            style="@style/RC.RowSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp" />

        <TextView
            android:id="@+id/regStatus"
            style="@style/RC.RowSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:drawablePadding="5dp"
            android:gravity="center_vertical"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/regAdd"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/rc_icon_square"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_add"
        android:visibility="gone"
        app:tint="@color/green_primary" />

    <ImageView
        android:id="@+id/regChevron"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        android:visibility="gone"
        app:tint="@color/dark_text" />
</LinearLayout>
