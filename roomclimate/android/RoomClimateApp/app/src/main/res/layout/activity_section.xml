<?xml version="1.0" encoding="utf-8"?>
<!-- Общая раскладка экранов-разделов из макета (Профиль, Семейный доступ, Безопасность,
     Уведомления, Единицы измерения, Помощь): шапка, подзаголовок, описание, белая карточка
     со строками или полями, кнопка, примечание. Содержимое заполняет экран. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_default"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/include_sub_header" />

        <LinearLayout style="@style/RC.Content">

            <TextView
                android:id="@+id/tvSectionHeading"
                style="@style/RC.Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvSectionDesc"
                style="@style/RC.Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/sectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_white_card"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:id="@+id/sectionExtra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btnSectionPrimary"
                style="@style/RC.Button.Primary"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:backgroundTint="@null" />

            <TextView
                android:id="@+id/tvSectionNote"
                style="@style/RC.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
