<?xml version="1.0" encoding="utf-8"?>
<!-- «Устройства» (макет Figma): сводка, активные помещения (с платами) и датчики из базы
     сервера, «Добавить помещение» / «Добавить датчик». Пустое состояние — две карточки. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_default">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/bottomNav"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RC.Text.Overline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/header_label" />

                    <TextView
                        style="@style/RC.Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="@string/devices_title" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnBell"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/rc_circle_white"
                    android:contentDescription="@string/a11y_notifications"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/dark_text" />
            </LinearLayout>

            <!-- Сводка: «3 помещения · 3 платы · 4 датчика · Все на связи» -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_home_card"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/rc_circle_white"
                    android:importantForAccessibility="no"
                    android:padding="8dp"
                    android:src="@drawable/ic_home_outline"
                    app:tint="@color/green_primary" />

                <TextView
                    android:id="@+id/tvSummary"
                    style="@style/RC.Text.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/connection_checking_short"
                    android:textColor="@color/green_primary" />

                <TextView
                    android:id="@+id/tvSummaryStatus"
                    style="@style/RC.Text.Accent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:drawablePadding="5dp"
                    android:gravity="center_vertical"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/rc_dot_small_green" />
            </LinearLayout>

            <!-- Пусто: помещений нет -->
            <LinearLayout
                android:id="@+id/cardEmptyRooms"
                style="@style/RC.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">

                <TextView
                    style="@style/RC.Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dev_empty_rooms_title" />

                <TextView
                    style="@style/RC.Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/dev_empty_rooms_text" />

                <Button
                    android:id="@+id/btnAddRoomEmpty"
                    style="@style/RC.Button.Secondary"
                    android:layout_marginTop="14dp"
                    android:text="@string/dev_add_room"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <!-- Помещения -->
            <LinearLayout
                android:id="@+id/roomsBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/RC.Text.Group"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dev_rooms_group" />

                    <TextView
                        android:id="@+id/tvRoomsCount"
                        style="@style/RC.Text.Accent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/roomsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_white_card"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />

                <Button
                    android:id="@+id/btnAddRoom"
                    style="@style/RC.Button.Secondary"
                    android:layout_marginTop="12dp"
                    android:text="@string/dev_add_room"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <!-- Пусто: датчиков нет -->
            <LinearLayout
                android:id="@+id/cardEmptySensors"
                style="@style/RC.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">

                <TextView
                    style="@style/RC.Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dev_empty_sensors_title" />

                <TextView
                    android:id="@+id/tvEmptySensors"
                    style="@style/RC.Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/dev_empty_sensors_no_rooms" />
            </LinearLayout>

            <!-- Датчики -->
            <LinearLayout
                android:id="@+id/sensorsBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/RC.Text.Group"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dev_sensors_group" />

                    <TextView
                        android:id="@+id/tvSensorsCount"
                        style="@style/RC.Text.Accent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sensorsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_white_card"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/addSensorBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnAddSensor"
                    style="@style/RC.Button.Primary"
                    android:layout_marginTop="16dp"
                    android:text="@string/dev_add_sensor"
                    app:backgroundTint="@null" />

                <TextView
                    style="@style/RC.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_horizontal"
                    android:text="@string/dev_add_sensor_note" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/include_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
