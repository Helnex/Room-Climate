<?xml version="1.0" encoding="utf-8"?>
<!-- Восстановление пароля: шаг 1 — email и «Получить код», шаг 2 — код и новый пароль. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_default"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="32dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/header_label"
            android:textColor="@color/gray_text"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/forgot_title"
            android:textColor="@color/dark_text"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/tvForgotInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/forgot_desc"
            android:textColor="@color/gray_text"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_white_card"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/editForgotEmail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:autofillHints="emailAddress"
                android:background="@drawable/bg_input_field"
                android:hint="@string/hint_email"
                android:inputType="textEmailAddress"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="@color/dark_text"
                android:textColorHint="@color/gray_text_light"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnSendCode"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_btn_primary"
                android:text="@string/btn_send_code"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <!-- Шаг 2: появляется после отправки кода -->
            <LinearLayout
                android:id="@+id/stepReset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/editResetCode"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="20dp"
                    android:autofillHints="smsOTPCode"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/hint_reset_code"
                    android:inputType="number"
                    android:maxLength="6"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:textColor="@color/dark_text"
                    android:textColorHint="@color/gray_text_light"
                    android:textSize="16sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp">

                    <EditText
                        android:id="@+id/editNewPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:autofillHints="newPassword"
                        android:background="@drawable/bg_input_field"
                        android:hint="@string/hint_new_password"
                        android:inputType="textPassword"
                        android:paddingStart="20dp"
                        android:paddingEnd="52dp"
                        android:textColor="@color/dark_text"
                        android:textColorHint="@color/gray_text_light"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/btnToggleNewPassword"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/password_show"
                        android:padding="12dp"
                        android:src="@drawable/ic_eye" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="6dp"
                    android:text="@string/password_rules"
                    android:textColor="@color/gray_text"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnResetPassword"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_btn_primary"
                    android:text="@string/btn_reset_password"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvBackToLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="@string/back_to_login"
            android:textColor="@color/green_primary"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
