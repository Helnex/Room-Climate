<?xml version="1.0" encoding="utf-8"?>
<!-- Шапка экрана второго уровня: кнопка «назад», «КЛИМАТ ПОМЕЩЕНИЯ», заголовок.
     ScreenHeader.bindSub(activity, R.string.…). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="6dp"
    android:paddingEnd="20dp"
    android:paddingBottom="10dp">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/rc_circle_white"
        android:contentDescription="@string/a11y_back"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_arrow_back" />

    <TextView
        style="@style/RC.Text.Overline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/header_label" />

    <TextView
        android:id="@+id/tvScreenTitle"
        style="@style/RC.Text.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:accessibilityHeading="true" />
</LinearLayout>
