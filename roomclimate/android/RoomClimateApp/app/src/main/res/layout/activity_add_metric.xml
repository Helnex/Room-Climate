<?xml version="1.0" encoding="utf-8"?>
<!-- «Добавить метрику» (макет, экраны 8/13): помещение, «Уже на дашборде», состояние
     «Новых метрик пока нет» с кнопкой «Добавить датчик», неактивная «Добавить метрику». -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_default"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/include_sub_header" />

        <LinearLayout style="@style/RC.Content">

            <TextView
                style="@style/RC.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/metric_add_desc"
                android:textColor="@color/gray_text" />

            <LinearLayout style="@style/RC.OutlinedField" android:layout_marginTop="16dp">
                <TextView style="@style/RC.FieldLabel" android:text="@string/sensor_room_label" />
                <TextView
                    android:id="@+id/tvMetricRoom"
                    style="@style/RC.FieldPicker"
                    android:text="@string/sensor_room_none" />
            </LinearLayout>

            <LinearLayout
                style="@style/RC.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    style="@style/RC.Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/metric_on_dashboard" />

                <LinearLayout
                    android:id="@+id/metricList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/rc_status_ok"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center_horizontal"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/green_primary" />

                <TextView
                    style="@style/RC.Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/metric_none_title" />

                <TextView
                    android:id="@+id/tvMetricNone"
                    style="@style/RC.Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/metric_none_text"
                    android:textColor="@color/green_primary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnMetricAddSensor"
                    style="@style/RC.Button.Primary"
                    android:layout_marginTop="12dp"
                    android:text="@string/sensor_add_button"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <Button
                style="@style/RC.Button.Primary"
                android:layout_marginTop="16dp"
                android:background="@drawable/rc_btn_disabled"
                android:enabled="false"
                android:text="@string/add_metric"
                android:textColor="@color/gray_text"
                app:backgroundTint="@null" />

            <TextView
                style="@style/RC.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/metric_no_duplicates" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
