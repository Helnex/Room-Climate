<?xml version="1.0" encoding="utf-8"?>
<!-- «Новое помещение» (макет): название и плата из базы сервера (NewRoomActivity). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_default">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/bottomNav"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/include_sub_header" />

            <LinearLayout style="@style/RC.Content">

                <TextView
                    style="@style/RC.Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/nr_desc" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/rc_card_r12"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <TextView
                        style="@style/RC.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/editRoomName"
                        android:text="@string/nr_name_label" />

                    <EditText
                        android:id="@+id/editRoomName"
                        style="@style/RC.FieldInput"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:hint="@string/room_name_hint"
                        android:importantForAutofill="no"
                        android:inputType="textCapSentences"
                        android:maxLength="40"
                        android:paddingStart="0dp"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBoardsGroup"
                    style="@style/RC.Text.Group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" />

                <TextView
                    style="@style/RC.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/nr_boards_hint" />

                <LinearLayout
                    android:id="@+id/boardsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_white_card"
                    android:orientation="vertical"
                    android:padding="6dp" />

                <TextView
                    android:id="@+id/tvBoardsNote"
                    style="@style/RC.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/nr_taken_note" />

                <Button
                    android:id="@+id/btnCreateRoom"
                    style="@style/RC.Button.Primary"
                    android:layout_marginTop="16dp"
                    android:text="@string/nr_create"
                    app:backgroundTint="@null" />

                <TextView
                    android:id="@+id/tvCreateNote"
                    style="@style/RC.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/include_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
