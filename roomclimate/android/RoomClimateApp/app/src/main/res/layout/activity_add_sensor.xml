<?xml version="1.0" encoding="utf-8"?>
<!-- «Добавление датчика» (макет, экраны 15/20/25): карточка найденной платы, название,
     показатель, помещение, кнопка. Платы находит сервер (они сами присылают показания). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_default"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/include_sub_header" />

        <LinearLayout style="@style/RC.Content">

            <TextView
                style="@style/RC.Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sensor_add_heading"
                android:textSize="22sp" />

            <TextView
                style="@style/RC.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/sensor_add_desc"
                android:textColor="@color/gray_text" />

            <!-- Найденная плата -->
            <LinearLayout
                android:id="@+id/boardCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/rc_chip"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/rc_circle_white"
                    android:importantForAccessibility="no"
                    android:padding="9dp"
                    android:src="@drawable/ic_wifi"
                    app:tint="@color/green_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvBoardTitle"
                        style="@style/RC.Text.BodyMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sensor_board_pick" />

                    <TextView
                        android:id="@+id/tvBoardState"
                        style="@style/RC.Text.Accent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/green_primary" />
            </LinearLayout>

            <LinearLayout style="@style/RC.OutlinedField" android:layout_marginTop="16dp">
                <TextView style="@style/RC.FieldLabel" android:labelFor="@id/editSensorName" android:text="@string/sensor_name_label" />
                <EditText
                    android:id="@+id/editSensorName"
                    style="@style/RC.FieldInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="@string/sensor_name_hint"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:maxLength="40" />
            </LinearLayout>

            <LinearLayout style="@style/RC.OutlinedField" android:layout_marginTop="16dp">
                <TextView style="@style/RC.FieldLabel" android:text="@string/sensor_metric_label" />
                <TextView
                    android:id="@+id/tvSensorKind"
                    style="@style/RC.FieldPicker"
                    android:text="@string/kind_climate" />
            </LinearLayout>

            <LinearLayout style="@style/RC.OutlinedField" android:layout_marginTop="16dp">
                <TextView style="@style/RC.FieldLabel" android:text="@string/sensor_room_label" />
                <TextView
                    android:id="@+id/tvSensorRoom"
                    style="@style/RC.FieldPicker"
                    android:text="@string/sensor_room_none" />
            </LinearLayout>

            <Button
                android:id="@+id/btnAddSensor"
                style="@style/RC.Button.Primary"
                android:layout_marginTop="16dp"
                android:text="@string/sensor_add_button"
                app:backgroundTint="@null" />

            <TextView
                style="@style/RC.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/sensor_add_note" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
