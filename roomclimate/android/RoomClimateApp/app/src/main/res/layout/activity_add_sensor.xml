<?xml version="1.0" encoding="utf-8"?>
<!-- «Добавление датчика» (макет): датчик из базы сервера, название, показатель (из записи
     датчика, не меняется), помещение → его плата. AddSensorActivity. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_default">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/bottomNav"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/include_sub_header" />

            <LinearLayout style="@style/RC.Content">

                <TextView
                    style="@style/RC.Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/as_desc" />

                <TextView
                    style="@style/RC.Text.Group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/as_group" />

                <LinearLayout
                    android:id="@+id/sensorCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_home_card"
                    android:foreground="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvSensorTitle"
                        style="@style/RC.Text.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/as_none"
                        android:textColor="@color/green_primary" />

                    <TextView
                        android:id="@+id/tvSensorState"
                        style="@style/RC.Text.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/green_primary" />

                    <TextView
                        android:id="@+id/tvSensorPick"
                        style="@style/RC.Text.BodyMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/as_pick"
                        android:textColor="@color/green_primary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/rc_card_r12"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <TextView
                        style="@style/RC.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/editSensorName"
                        android:text="@string/as_name_label" />

                    <EditText
                        android:id="@+id/editSensorName"
                        style="@style/RC.FieldInput"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:hint="@string/sensor_name_hint"
                        android:importantForAutofill="no"
                        android:inputType="textCapSentences"
                        android:maxLength="40"
                        android:paddingStart="0dp"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/rc_card_r12"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <TextView
                        style="@style/RC.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/as_metric_label" />

                    <TextView
                        android:id="@+id/tvSensorMetric"
                        style="@style/RC.Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/value_placeholder"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/roomCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/rc_card_r12"
                    android:foreground="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <TextView
                        style="@style/RC.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/as_room_label" />

                    <TextView
                        android:id="@+id/tvRoomName"
                        style="@style/RC.Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/as_room_none"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvRoomBoard"
                        style="@style/RC.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:visibility="gone" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnAddSensor"
                    style="@style/RC.Button.Primary"
                    android:layout_marginTop="16dp"
                    android:text="@string/as_button"
                    app:backgroundTint="@null" />

                <TextView
                    android:id="@+id/tvAddNote"
                    style="@style/RC.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/as_note_empty" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/include_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
