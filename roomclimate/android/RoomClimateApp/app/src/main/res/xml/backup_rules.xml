<?xml version="1.0" encoding="utf-8"?>
<!--
   Правила резервного копирования для Android 11 и ниже.
   Токен сессии (roomclimate_user.xml) не должен попадать в облачную копию:
   иначе после восстановления на другом телефоне он даёт доступ к аккаунту.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="roomclimate_user.xml" />
</full-backup-content>
