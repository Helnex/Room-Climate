<?xml version="1.0" encoding="utf-8"?>
<!--
   Правила резервного копирования и переноса для Android 12+.
   Токен сессии (roomclimate_user.xml) не копируется ни в облако, ни на новый телефон.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="roomclimate_user.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="roomclimate_user.xml" />
    </device-transfer>
</data-extraction-rules>
